# --- Database ---
DATABASE_URL=postgresql://interview_user:interview_pass@localhost:5432/interview_db

# --- Auth / JWT ---
JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- NLP / ML ---
SBERT_MODEL_NAME=all-MiniLM-L6-v2

# --- Evaluation weights (must sum to 1.0) ---
EVAL_WEIGHT_RELEVANCE=0.25
EVAL_WEIGHT_SEMANTIC=0.30
EVAL_WEIGHT_CONCEPT=0.20
EVAL_WEIGHT_COMPLETENESS=0.15
EVAL_WEIGHT_GRAMMAR=0.10

# --- Adaptive difficulty thresholds ---
ADAPTIVE_SCORE_INCREASE=80
ADAPTIVE_SCORE_MAINTAIN_LOW=50

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- App ---
ENVIRONMENT=development
DEFAULT_QUESTIONS_PER_INTERVIEW=10
